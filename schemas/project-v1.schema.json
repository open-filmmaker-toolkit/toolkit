{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Open Filmmaker Toolkit project file, version 1",
  "description": "The shared, local-first project file used by Open Filmmaker Toolkit tools. Unknown properties are allowed so tools can preserve fields owned by other tools.",
  "type": "object",
  "required": [
    "format",
    "formatVersion",
    "project",
    "thirdPartyElements"
  ],
  "properties": {
    "format": {
      "const": "open-filmmaker-toolkit/project"
    },
    "formatVersion": {
      "const": 1
    },
    "project": {
      "$ref": "#/$defs/project"
    },
    "people": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/person"
      }
    },
    "locations": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/location"
      }
    },
    "thirdPartyElements": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/thirdPartyElement"
      }
    },
    "contracts": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/contract"
      }
    },
    "assets": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/asset"
      }
    },
    "musicCueSheet": {
      "$ref": "#/$defs/musicCueSheet"
    },
    "callSheets": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/callSheet"
      }
    },
    "credits": {
      "$ref": "#/$defs/credits"
    },
    "supers": {
      "$ref": "#/$defs/supers"
    },
    "subjects": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/subject"
      },
      "description": "People you might film, kept by the subject tracker until they're added to people."
    },
    "sources": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/source"
      },
      "description": "Research sources and archival leads, kept by the research and archival log."
    },
    "comps": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/comp"
      },
      "description": "Comparable films for pitches and sales, kept by the comps tracker."
    },
    "treatment": {
      "$ref": "#/$defs/treatment"
    },
    "pitchDeck": {
      "$ref": "#/$defs/pitchDeck"
    }
  },
  "additionalProperties": true,
  "$defs": {
    "id": {
      "type": "string",
      "minLength": 1
    },
    "project": {
      "type": "object",
      "properties": {
        "title": {
          "type": "string"
        },
        "company": {
          "type": "string"
        },
        "producer": {
          "type": "string"
        },
        "distributor": {
          "type": "string"
        },
        "releaseDate": {
          "type": "string"
        },
        "runningTime": {
          "type": "string"
        },
        "startTimecode": {
          "type": "string"
        },
        "preparedBy": {
          "type": "string"
        },
        "preparedContact": {
          "type": "string"
        },
        "cutVersion": {
          "type": "string"
        },
        "frameRate": {
          "type": "number",
          "enum": [
            23.976,
            24,
            25,
            29.97,
            30,
            48,
            50,
            59.94,
            60
          ]
        },
        "currency": {
          "type": "string",
          "pattern": "^[A-Za-z]{3}$"
        }
      },
      "additionalProperties": true
    },
    "person": {
      "type": "object",
      "required": [
        "id",
        "name"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/id"
        },
        "name": {
          "type": "string",
          "minLength": 1
        },
        "roles": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "email": {
          "type": "string"
        },
        "phone": {
          "type": "string"
        },
        "notes": {
          "type": "string"
        },
        "onCamera": {
          "type": "boolean",
          "description": "True if this person appears or is heard on camera and needs a release. False excludes them even if a release names them."
        }
      },
      "additionalProperties": true
    },
    "location": {
      "type": "object",
      "required": [
        "id",
        "name"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/id"
        },
        "name": {
          "type": "string",
          "minLength": 1
        },
        "address": {
          "type": "string"
        },
        "city": {
          "type": "string"
        },
        "region": {
          "type": "string"
        },
        "postalCode": {
          "type": "string"
        },
        "country": {
          "type": "string"
        },
        "notes": {
          "type": "string"
        },
        "latitude": {
          "type": "number",
          "minimum": -90,
          "maximum": 90
        },
        "longitude": {
          "type": "number",
          "minimum": -180,
          "maximum": 180
        },
        "onCamera": {
          "type": "boolean",
          "description": "True if this place is filmed and needs a location release. False excludes it even if a call sheet uses it."
        }
      },
      "additionalProperties": true
    },
    "thirdPartyElement": {
      "type": "object",
      "required": [
        "id"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/id"
        },
        "description": {
          "type": "string"
        },
        "type": {
          "type": "string"
        },
        "status": {
          "enum": [
            "not-started",
            "requested",
            "negotiating",
            "licensed",
            "fair-use",
            "public-domain",
            "replace"
          ]
        },
        "source": {
          "type": "string"
        },
        "rightsHolder": {
          "type": "string"
        },
        "contact": {
          "type": "string"
        },
        "tcIn": {
          "type": "string"
        },
        "tcOut": {
          "type": "string"
        },
        "use": {
          "type": "string"
        },
        "rights": {
          "type": "string"
        },
        "cost": {
          "type": [
            "number",
            "null"
          ],
          "minimum": 0
        },
        "licenseRef": {
          "type": "string"
        },
        "notes": {
          "type": "string"
        },
        "contractIds": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/id"
          },
          "uniqueItems": true
        },
        "music": {
          "$ref": "#/$defs/music"
        },
        "createdAt": {
          "type": "string"
        },
        "updatedAt": {
          "type": "string"
        }
      },
      "additionalProperties": true
    },
    "music": {
      "type": "object",
      "properties": {
        "title": {
          "type": "string"
        },
        "artist": {
          "type": "string"
        },
        "cueId": {
          "type": "string"
        },
        "usage": {
          "enum": [
            "BI",
            "BV",
            "VI",
            "VV",
            "MT",
            "ET",
            ""
          ]
        },
        "writers": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/musicParty"
          }
        },
        "publishers": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/musicParty"
          }
        }
      },
      "additionalProperties": true
    },
    "musicParty": {
      "type": "object",
      "properties": {
        "name": {
          "type": "string"
        },
        "role": {
          "type": "string"
        },
        "society": {
          "type": "string"
        },
        "share": {
          "type": [
            "number",
            "null"
          ],
          "minimum": 0,
          "maximum": 100
        }
      },
      "additionalProperties": true
    },
    "contract": {
      "type": "object",
      "required": [
        "id",
        "title"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/id"
        },
        "title": {
          "type": "string",
          "minLength": 1
        },
        "type": {
          "type": "string"
        },
        "status": {
          "type": "string"
        },
        "personIds": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/id"
          },
          "uniqueItems": true
        },
        "locationIds": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/id"
          },
          "uniqueItems": true
        },
        "thirdPartyElementIds": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/id"
          },
          "uniqueItems": true
        },
        "assetIds": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/id"
          },
          "uniqueItems": true
        },
        "signedDate": {
          "type": "string"
        },
        "effectiveDate": {
          "type": "string"
        },
        "expirationDate": {
          "type": "string"
        },
        "notes": {
          "type": "string"
        },
        "requiredCredit": {
          "type": "string",
          "description": "Exact wording of an on-screen credit this agreement requires."
        }
      },
      "additionalProperties": true
    },
    "asset": {
      "type": "object",
      "required": [
        "id",
        "name"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/id"
        },
        "name": {
          "type": "string",
          "minLength": 1
        },
        "type": {
          "type": "string"
        },
        "relativePath": {
          "type": "string"
        },
        "mimeType": {
          "type": "string"
        },
        "notes": {
          "type": "string"
        }
      },
      "additionalProperties": true
    },
    "musicCueSheet": {
      "type": "object",
      "properties": {
        "musicSupervisor": {
          "type": "string"
        }
      },
      "additionalProperties": true
    },
    "callSheet": {
      "type": "object",
      "required": [
        "id",
        "date"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/id"
        },
        "date": {
          "type": "string",
          "pattern": "^\\d{4}-\\d{2}-\\d{2}$",
          "description": "Shoot date, YYYY-MM-DD."
        },
        "dayLabel": {
          "type": "string",
          "description": "For example \"Day 2 of 5\"."
        },
        "generalCall": {
          "type": "string",
          "pattern": "^([01]\\d|2[0-3]):[0-5]\\d$",
          "description": "24-hour HH:MM."
        },
        "wrapTime": {
          "type": "string",
          "pattern": "^([01]\\d|2[0-3]):[0-5]\\d$"
        },
        "locationId": {
          "$ref": "#/$defs/id"
        },
        "parking": {
          "type": "string"
        },
        "weather": {
          "type": "string"
        },
        "sunrise": {
          "type": "string"
        },
        "sunset": {
          "type": "string"
        },
        "hospital": {
          "type": "object",
          "properties": {
            "name": {
              "type": "string"
            },
            "address": {
              "type": "string"
            },
            "phone": {
              "type": "string"
            }
          },
          "additionalProperties": true
        },
        "schedule": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "time": {
                "type": "string"
              },
              "description": {
                "type": "string"
              }
            },
            "additionalProperties": true
          }
        },
        "crew": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "personId"
            ],
            "properties": {
              "personId": {
                "$ref": "#/$defs/id"
              },
              "callTime": {
                "type": "string",
                "pattern": "^([01]\\d|2[0-3]):[0-5]\\d$"
              },
              "role": {
                "type": "string"
              },
              "notes": {
                "type": "string"
              }
            },
            "additionalProperties": true
          }
        },
        "notes": {
          "type": "string"
        }
      },
      "additionalProperties": true
    },
    "credits": {
      "type": "object",
      "description": "The film's credits, in order, as built by the credits builder.",
      "properties": {
        "entries": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/creditEntry"
          }
        },
        "notCredited": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/id"
          },
          "uniqueItems": true,
          "description": "People who are deliberately left out of the credits."
        }
      },
      "additionalProperties": true
    },
    "creditEntry": {
      "type": "object",
      "required": [
        "id",
        "kind"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/id"
        },
        "kind": {
          "enum": [
            "credit",
            "heading",
            "text",
            "music",
            "archival"
          ],
          "description": "credit: a line with names under it. heading: a section heading. text: lines shown as typed. music and archival: blocks built from the third-party elements."
        },
        "role": {
          "type": "string",
          "description": "For a credit, the line above the names."
        },
        "personIds": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/id"
          },
          "uniqueItems": true
        },
        "names": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "description": "Names that aren't people in the project, shown after personIds."
        },
        "text": {
          "type": "string",
          "description": "For a heading or text entry."
        },
        "heading": {
          "type": "string",
          "description": "For a music or archival block."
        },
        "excluded": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "description": "For a music or archival block, the songs or sources left out, as lowercase keys of their title or name."
        }
      },
      "additionalProperties": true
    },
    "supers": {
      "type": "object",
      "description": "On-screen names and titles (supers and lower thirds), as kept by the name supers list.",
      "properties": {
        "entries": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/superEntry"
          }
        },
        "lastExport": {
          "type": "object",
          "description": "What the list looked like when it was last exported for graphics, so changes since then can be flagged.",
          "properties": {
            "at": {
              "type": "string",
              "format": "date-time"
            },
            "cutVersion": {
              "type": "string"
            },
            "entries": {
              "type": "array",
              "items": {
                "type": "object",
                "required": [
                  "id"
                ],
                "properties": {
                  "id": {
                    "$ref": "#/$defs/id"
                  },
                  "name": {
                    "type": "string"
                  },
                  "title": {
                    "type": "string"
                  },
                  "firstAppears": {
                    "type": "string"
                  }
                },
                "additionalProperties": true
              }
            }
          },
          "additionalProperties": true
        }
      },
      "additionalProperties": true
    },
    "superEntry": {
      "type": "object",
      "required": [
        "id"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/id"
        },
        "personId": {
          "$ref": "#/$defs/id",
          "description": "A person in people. Their name is used, so the spelling matches the rest of the project."
        },
        "name": {
          "type": "string",
          "description": "The name on screen, for someone who isn't in people."
        },
        "title": {
          "type": "string",
          "description": "The second line of the super."
        },
        "firstAppears": {
          "type": "string",
          "description": "Timecode in the cut where the super first appears, as HH:MM:SS:FF."
        },
        "notes": {
          "type": "string"
        }
      },
      "additionalProperties": true
    },
    "subject": {
      "type": "object",
      "required": [
        "id"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/id"
        },
        "name": {
          "type": "string"
        },
        "about": {
          "type": "string",
          "description": "Who they are, in a line."
        },
        "foundVia": {
          "type": "string",
          "description": "How you found them."
        },
        "phone": {
          "type": "string"
        },
        "email": {
          "type": "string"
        },
        "status": {
          "enum": [
            "researching",
            "in-conversation",
            "agreed",
            "declined"
          ]
        },
        "lastContact": {
          "type": "string",
          "format": "date"
        },
        "nextFollowUp": {
          "type": "string",
          "format": "date"
        },
        "nextFollowUpNote": {
          "type": "string"
        },
        "notes": {
          "type": "string",
          "description": "Story notes."
        },
        "log": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "date": {
                "type": "string",
                "format": "date"
              },
              "note": {
                "type": "string"
              }
            },
            "additionalProperties": true
          }
        },
        "personId": {
          "$ref": "#/$defs/id",
          "description": "The person in people this subject became."
        }
      },
      "additionalProperties": true
    },
    "source": {
      "type": "object",
      "required": [
        "id"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/id"
        },
        "kind": {
          "enum": [
            "archival",
            "research"
          ]
        },
        "title": {
          "type": "string",
          "description": "What it is."
        },
        "status": {
          "enum": [
            "found",
            "screener-requested",
            "screener-received",
            "ready-to-license",
            "to-check",
            "checked",
            "using",
            "not-using"
          ],
          "description": "Archival leads: found, screener-requested, screener-received, ready-to-license or not-using. Research sources: to-check, checked, using or not-using."
        },
        "type": {
          "type": "string",
          "description": "A clearance log type, such as Archival footage."
        },
        "archive": {
          "type": "string",
          "description": "Archive or collection; for research sources, the author or publisher."
        },
        "itemId": {
          "type": "string"
        },
        "link": {
          "type": "string",
          "description": "A catalog link or call number, kept as text."
        },
        "rightsHolder": {
          "type": "string"
        },
        "contact": {
          "type": "string"
        },
        "cost": {
          "type": "number",
          "minimum": 0,
          "description": "Estimated cost."
        },
        "currency": {
          "type": "string",
          "pattern": "^[A-Z]{3}$"
        },
        "rightsNotes": {
          "type": "string"
        },
        "notes": {
          "type": "string"
        },
        "elementId": {
          "$ref": "#/$defs/id",
          "description": "The third-party element this source became in the clearance log."
        }
      },
      "additionalProperties": true
    },
    "comp": {
      "type": "object",
      "required": [
        "id"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/id"
        },
        "title": {
          "type": "string"
        },
        "year": {
          "type": "integer",
          "minimum": 1890
        },
        "runtime": {
          "type": "number",
          "exclusiveMinimum": 0,
          "description": "Running time in minutes."
        },
        "director": {
          "type": "string"
        },
        "premiere": {
          "type": "string"
        },
        "distributor": {
          "type": "string"
        },
        "platforms": {
          "type": "string",
          "description": "Where it played."
        },
        "figures": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "label": {
                "type": "string"
              },
              "amount": {
                "type": "string"
              },
              "source": {
                "type": "string",
                "description": "Where the figure was reported."
              }
            },
            "additionalProperties": true
          }
        },
        "subjectTags": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "uniqueItems": true
        },
        "styleTags": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "uniqueItems": true
        },
        "audienceTags": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "uniqueItems": true
        },
        "why": {
          "type": "string",
          "description": "Why it's comparable, for the pitch."
        },
        "notes": {
          "type": "string"
        },
        "inPitch": {
          "type": "boolean",
          "description": "On the printed comps page."
        }
      },
      "additionalProperties": true
    },
    "treatment": {
      "type": "object",
      "description": "The film's treatment, written in the treatment builder.",
      "properties": {
        "sections": {
          "type": "object",
          "properties": {
            "logline": {
              "type": "string"
            },
            "shortSynopsis": {
              "type": "string"
            },
            "longSynopsis": {
              "type": "string"
            },
            "subjects": {
              "type": "string"
            },
            "structure": {
              "type": "string"
            },
            "approach": {
              "type": "string"
            },
            "access": {
              "type": "string"
            },
            "whyNow": {
              "type": "string"
            },
            "team": {
              "type": "string"
            }
          },
          "additionalProperties": {
            "type": "string"
          },
          "description": "Text for each part of the treatment: logline, shortSynopsis, longSynopsis, subjects, structure, approach, access, whyNow, team."
        },
        "targets": {
          "type": "object",
          "additionalProperties": {
            "type": "integer",
            "minimum": 1
          },
          "description": "Word targets that differ from the tool's defaults, by section."
        },
        "versions": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "id"
            ],
            "properties": {
              "id": {
                "$ref": "#/$defs/id"
              },
              "at": {
                "type": "string",
                "format": "date-time"
              },
              "label": {
                "type": "string"
              },
              "sections": {
                "type": "object",
                "properties": {
                  "logline": {
                    "type": "string"
                  },
                  "shortSynopsis": {
                    "type": "string"
                  },
                  "longSynopsis": {
                    "type": "string"
                  },
                  "subjects": {
                    "type": "string"
                  },
                  "structure": {
                    "type": "string"
                  },
                  "approach": {
                    "type": "string"
